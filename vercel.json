{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/inizia",
      "destination": "/?utm_source=scatola&utm_medium=qr&utm_campaign=scatola",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/dentisti",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
