{
  "buildCommand": "npm run build",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/(dentisti|v1|v2|v3|v4|v5)",
      "destination": "/spa.html"
    }
  ],
  "redirects": [
    {
      "source": "/inizia",
      "destination": "/?utm_source=scatola&utm_medium=qr&utm_campaign=scatola",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/dentisti",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(v1|v2|v3|v4|v5)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/spa.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
